# Use one of the following TMDB credential types.
# Preferred: the API Read Access Token from your TMDB account settings.
TMDB_READ_TOKEN=replace_with_your_tmdb_read_access_token

# Alternative: the TMDB v3 API key.
# TMDB_API_KEY=replace_with_your_tmdb_v3_api_key

# Optional override for the extracted model artifact directory.
# MODEL_OUTPUT_PATH=Recommend System/pytorch_hybrid_outputs_full
